// Mizo phoneme definitions
//
// Mizo (lus) language phoneme table.
// Language: Mizo
//
// This file contains Mizo-specific phonemes.
// Common phonemes are inherited through the lus phoneme table.

 
// Mizo contrasts voiceless unaspirated and aspirated stops.
// The plain spellings use p/t/k; ph/th/kh will map to p_h/t_h/k_h
// in the spelling-to-phoneme rules.

phoneme p
  vls blb stp
  ipa p
  voicingswitch b
  lengthmod 2
  Vowelin  f1=0  f2=1000 -50 -100  f3=-200 80 amp=11
  Vowelout f1=0  f2=1000 -500 -350  f3=-300 80 rms=22
  IF nextPh(isPause2) THEN
    WAV(ustop/p_)
  ENDIF
  WAV(ustop/p_unasp)
endphoneme

phoneme p_h
  vls blb stp
  ipa pʰ
  voicingswitch b
  lengthmod 2
  Vowelin  f1=0  f2=1000 -50 -100  f3=-200 80
  Vowelout f1=0  f2=1000 -500 -350  f3=-300 80 rms=30
  WAV(ustop/p_asp)
endphoneme

phoneme t
  vls alv stp
  ipa t
  voicingswitch d
  lengthmod 2
  Vowelin f1=0 f2=1700 -300 300 f3=-100 80
  Vowelout f1=0 f2=1700 -300 250 f3=-100 80 rms=20
  IF nextPh(isPause2) THEN
    WAV(ustop/t_)
  ENDIF
  WAV(ustop/t_unasp)
endphoneme

phoneme t_h
  vls alv stp
  ipa tʰ
  voicingswitch d
  lengthmod 2
  Vowelin f1=0 f2=1700 -300 300 f3=-100 80
  Vowelout f1=0 f2=1700 -300 250 f3=-100 80 rms=20
  WAV(ustop/t)
endphoneme

phoneme k
  vls vel stp
  ipa k
  voicingswitch g
  lengthmod 2
  Vowelin f1=0 f2=2300 200 300 f3=-200 80
  Vowelout f1=0 f2=2300 300 400 f3=-200 80 rms=20
  IF KlattSynth THEN
    Vowelout f1=0 f2=2300 200 300 f3=-200 80 rms=20
  ENDIF
  IF nextPh(isPause2) THEN
    WAV(ustop/k_)
  ENDIF
  WAV(ustop/k_unasp)
endphoneme

phoneme k_h
  vls vel stp
  ipa kʰ
  voicingswitch g
  lengthmod 2
  Vowelin f1=0 f2=2300 200 300 f3=-150 80
  Vowelout f1=0 f2=2300 300 400 f3=-150 80 rms=20
  WAV(ustop/k_asp)
endphoneme

// The Mizo spelling aw represents the open-mid back vowel /ɔ/.
phoneme O
  vwl starttype #o endtype #o
  ipa ɔ
  length 180
  FMT(vowel/oo_4)
endphoneme

// Mizo ch is the voiceless alveolar affricate /t͡s/.
// Reuse eSpeak's alveolar sibilant affricate sample sequence.
phoneme ts
  vls alv sib afr
  ipa t͡s
  lengthmod 2
  Vowelin f1=0 f2=2300 200 400 f3=-100 80
  WAV(ustop/ts_pzd)
endphoneme

 // Mizo diphthongs with existing eSpeak transition recordings.
phoneme aI
  vwl starttype #a endtype #i
  ipa aɪ̯
  length 240
  FMT(vdiph/ai_2)
endphoneme

phoneme eI
  vwl starttype #e endtype #i
  ipa eɪ̯
  length 210
  FMT(vdiph/eei)
endphoneme

phoneme OI
  vwl starttype #o endtype #i
  ipa oɪ̯
  length 230
  FMT(vdiph/ooi)
endphoneme

phoneme aU
  vwl starttype #a endtype #u
  ipa aʊ̯
  length 230
  FMT(vdiph/au)
endphoneme
